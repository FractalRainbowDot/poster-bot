# Poster Bot environment — PLACEHOLDERS ONLY. Never commit real secrets.
# Live mode requires: BOT_TOKEN (non-placeholder), OWNER_USER_ID, CHANNEL_ID.
# CHANNEL_ID: numeric channel id (-100...) or public @channel-username
# (resolved to its numeric id only at live startup; offline check accepts both).
# Offline `poster-bot check` works with these dummy values.

POSTER_BOT_BOT_TOKEN=REPLACE_WITH_REAL_BOT_TOKEN
POSTER_BOT_OWNER_USER_ID=0
POSTER_BOT_CHANNEL_ID=0

# Local paths (optional, defaults shown)
POSTER_BOT_DB_PATH=data/poster_bot.sqlite3
POSTER_BOT_LOCK_PATH=data/poster_bot.lock

# Schedule defaults (optional). Slot hours default to the full day 0..23.
POSTER_BOT_TIMEZONE=Europe/Moscow
POSTER_BOT_SLOT_START_HOUR=0
POSTER_BOT_SLOT_END_HOUR=23

# Mandatory signature footer REQUIRED for publication (all four together;
# example values only — replace with the real channels). Every published
# part ends with the bottom line '<main> | <partner>'; the first pair is the
# bot's own channel, the second is the partner channel.
POSTER_BOT_SIGNATURE_MAIN_TEXT=@channel_main
POSTER_BOT_SIGNATURE_MAIN_URL=https://t.me/channel_main
POSTER_BOT_SIGNATURE_PARTNER_TEXT=@channel_partner
POSTER_BOT_SIGNATURE_PARTNER_URL=https://t.me/channel_partner
